// Lint rules for the site's JavaScript, the scripts and the tests (npm run lint).
// Catches code that is wrong or most likely wrong; style rules that fight how
// this code is written are switched off below.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error", "suspicious": "error" },
  "rules": {
    "no-undef": "error",
    // `x ? a() : b()` and `ok && run()` as statements are this codebase's style.
    "no-unused-expressions": ["error", { "allowTernary": true, "allowShortCircuit": true }],
    // Helpers live inside each page's wrapper function on purpose.
    "unicorn/consistent-function-scoping": "off",
    // Sorting in place is intended where it's used.
    "unicorn/no-array-sort": "off"
  },
  "env": { "browser": true, "es2024": true },
  // assets/vendor: other people's code (pdf.js), committed as they publish it.
  // .claude/skills/security-audit: Cloudflare's skill, installed by `npx skills`
  // (skills-lock.json); editing it would break the lock's hash.
  "ignorePatterns": ["style-guides/**", "assets/vendor/**", ".claude/skills/security-audit/**"],
  "overrides": [
    { "files": ["sw.js"], "env": { "serviceworker": true } },
    { "files": ["assets/recipe-icons.js", "moved/moved.js"], "globals": { "module": "readonly" } },
    // Works in Node (module, require) and in a page, like recipe-icons.js.
    { "files": ["assets/recipe-checks.js"], "globals": { "module": "readonly", "require": "readonly" } },
    // These post to and from a Web Worker, whose postMessage takes no target
    // origin (its second argument is a transfer list); the rule is for windows.
    { "files": ["assets/menu.mjs", "assets/plan-worker.mjs"], "rules": { "unicorn/require-post-message-target-origin": "off" } },
    { "files": ["scripts/**", "tests/**", "tools/**", "*.config.mjs", ".claude/hooks/**"], "env": { "node": true } },
    // Browser tests go through the fixture, which blocks every request to
    // another site and serves the test recipes instead of the real ones.
    {
      "files": ["tests/e2e/**"],
      "rules": {
        "no-restricted-imports": ["error", { "paths": [{
          "name": "@playwright/test",
          "message": "Import test and expect from ./fixtures.mjs: it blocks outside requests and serves the test recipes."
        }] }]
      }
    },
    { "files": ["tests/e2e/fixtures.mjs"], "rules": { "no-restricted-imports": "off" } },
    // The Worker's helper script, test settings and fake GitHub run in Node.
    { "files": ["worker/scripts/**", "worker/test/**", "worker/*.config.ts"], "env": { "node": true } }
  ]
}
