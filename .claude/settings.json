{
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills",
        "ref": "d1478fcb140db0b93c0c8df17bcfd311844749d0"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills",
        "ref": "149d7b21f4067765b82e67029730b42d228ef4b4"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "insecure-defaults@trailofbits": true,
    "differential-review@trailofbits": true,
    "spec-to-code-compliance@trailofbits": true,
    "supply-chain-risk-auditor@trailofbits": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-skipped-checks.mjs\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/quick-checks.mjs", "timeout": 60 }]
      }
    ]
  }
}
