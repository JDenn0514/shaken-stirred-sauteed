{
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills",
        "ref": "d1478fcb140db0b93c0c8df17bcfd311844749d0"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-skipped-checks.mjs\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/quick-checks.mjs", "timeout": 60 }]
      }
    ]
  }
}
