// Cloudflare: one Worker serves the site at shaken-stirred-sauteed.com.
// The site's own files are served as they are ("static assets": free, and not
// counted against the daily request limit). Only /api/ runs the Worker's code
// (worker/src/index.js): the editor's sign-in now, and saving later.
// Cloudflare deploys this on every push to main (Workers Builds), and runs
// `wrangler preview` on every other branch. Files that aren't part of the site
// are kept out by .assetsignore.
{
  "name": "shaken-stirred-sauteed",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-01",
  // Better Auth (sign-in) needs Node's AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  // Not secret. The secrets (GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
  // BETTER_AUTH_SECRET) are set in Cloudflare's dashboard, never here.
  "vars": {
    "SITE_URL": "https://shaken-stirred-sauteed.com",
    "GITHUB_REPO": "JDenn0514/shaken-stirred-sauteed"
  },
  // Sign-in's users, sessions and GitHub tokens. Its tables are made by the
  // migrations in worker/migrations (README, "Hosting").
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shaken-stirred-sauteed-auth",
      "database_id": "51eb2ea4-0e34-4170-af8d-59ed784f0f63",
      "migrations_dir": "worker/migrations"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Keep page addresses exactly as they were on GitHub Pages (recipe.html?r=…),
    // not redirected to /recipe. A folder address ("/") falls through to the
    // Worker, which serves its index.html.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // `wrangler preview` (each branch's preview) needs this block. It's empty
  // because previews use the same settings as the live site.
  "previews": {}
}
