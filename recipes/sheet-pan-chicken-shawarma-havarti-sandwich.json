        "Turmeric",
        "Chili flakes",
        { "item": "Kosher salt", "group": "Chicken" }
      ],
      "hands": "4 min",
      "preheat": "425F"
    },
    {
      "do": "Spread the chicken in one layer on a sheet pan and roast 20 minutes, until cooked through. Switch to broil for 1 to 2 minutes to char the edges, then set the oven back to 425F (220C) for the sandwiches.",
      "wait": "20 min",
      "hands": "2 min",
      "oven": "425F"
    },
    {
      "do": "Seed the jalapeño if you want it milder, and grate the garlic for the tahini.",
