      "prepOnly": true,
      "uses": [
        "Oil-packed sun-dried tomatoes",
        "Sliced dill pickles and/or pepperoncini"
      ]
    },
    {
      "do": "Lay the naan flat on a sheet pan. Spread dressing over one half of each, then layer sun-dried tomatoes, pickles, both cheeses and the chicken. Cover with foil and bake 15 minutes, until the cheese melts; the foil keeps the naan soft while the filling heats.",
      "wait": "15 min",
      "uses": [
        "Naan",
        {
          "item": "Green tahini, Caesar or mayo",
          "amount": "some, to spread"
