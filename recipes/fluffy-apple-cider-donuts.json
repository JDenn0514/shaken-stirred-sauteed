{
  "title": "Fluffy Apple Cider Donuts",
  "category": "baking",
  "kind": "dish",
  "description": "Creamed-butter cake donuts with cider and nutmeg, brushed in cinnamon sugar.",
  "tags": {
    "type": ["breakfast-bakes"],
