  "heat": "350F",
  "heatLabel": "Oven",
  "beforeYouStart": [
    "Butter and eggs at room temperature. You need 2 sticks of butter in all: 10 Tbsp soft for the batter, 6 Tbsp melted for the coating.",
    "Lightly grease both donut pans with nonstick spray.",
    "Stand mixer with the paddle attachment."
  ],
  "ingredients": [
    {
