  "steps": [
    {
      "group": "Batter",
      "items": [
        {
          "do": "Heat the oven to 350°F (175°C).",
          "hands": "30 sec",
          "preheat": "350F"
        },
        {
          "do": "Set the 10 Tbsp butter and the eggs out to come to room temperature, grate the nutmeg, and lightly grease both donut pans.",
          "hands": "3 min",
          "prep": true,
          "prepOnly": true,
          "uses": [
            {
              "group": "Batter",
              "item": "Unsalted butter"
            },
            "Eggs",
            "Nutmeg"
          ]
        },
        {
          "do": "Whisk the flour, baking powder, salt, 1 tsp cinnamon and the nutmeg in a medium bowl.",
          "uses": [
            "All-purpose flour",
            "Baking powder",
            "Fine sea salt",
            {
              "item": "Ground cinnamon",
              "group": "Batter"
            },
            "Nutmeg"
          ],
          "hands": "2 min",
          "prep": true
        },
        {
          "do": "In the mixer, beat the 10 Tbsp butter with the brown sugar and the 1/4 cup granulated sugar on medium for 3 to 4 minutes. The air beaten in here is what makes these lighter than a one-bowl donut.",
          "wait": "3 to 4 min",
          "cue": "Light and fluffy",
          "uses": [
            {
              "item": "Unsalted butter",
              "group": "Batter"
            },
            "Light brown sugar",
            {
              "item": "Granulated sugar",
              "group": "Batter"
            }
          ],
          "hands": "30 sec"
        },
        {
          "do": "Beat in the eggs one at a time, letting each mix in fully and scraping the bowl as needed. Beat in the vanilla.",
          "uses": [
            "Eggs",
            "Vanilla extract"
          ],
          "hands": "3 min"
        },
        {
          "do": "On low, mix in the flour mixture until incorporated. With the mixer still running, pour in the cider in a slow, steady stream. Scrape the bowl well so the batter is even throughout.",
          "uses": [
            "Apple cider"
          ],
          "hands": "2 min"
        },
        {
          "do": "Spoon the batter into the pans, or pipe it from a zip-top bag with a 1/2-inch corner snipped off, filling each cavity about 2/3 full.",
          "hands": "4 min",
          "oven": false
        }
      ]
    },
    {
      "group": "Bake",
      "items": [
        {
          "do": "Bake, rotating the pans halfway through.",
          "wait": "12 to 15 min",
          "cue": "Evenly golden brown; a toothpick in the thickest part comes out clean",
          "hands": "1 min",
          "oven": "350F"
        },
        {
          "do": "While they bake, whisk the 1/2 cup sugar and 1 tsp cinnamon in a small bowl, and melt the 6 Tbsp butter in another.",
          "uses": [
            {
              "item": "Granulated sugar",
              "group": "Topping"
            },
            {
              "item": "Ground cinnamon",
              "group": "Topping"
            },
            {
              "item": "Unsalted butter",
              "group": "Topping"
            }
          ],
          "hands": "2 min",
          "prep": true
        }
      ]
    },
    {
      "group": "Coat",
      "items": [
        {
          "do": "Cool in the pans, then turn the donuts out.",
          "wait": "5 min",
          "hands": "30 sec",
          "oven": false
        },
        {
          "do": "While they're still warm, brush each donut with melted butter and dredge it in the cinnamon sugar.",
          "hands": "6 min"
        }
      ]
    }
  ],
  "notes": [
    {
      "group": "Make ahead & storage",
      "items": [
        "Best right after coating, but fine once cooled to room temperature."
      ]
    },
    {
      "group": "Substitutions",
      "items": [
        "No donut pans: divide the batter among a greased 12-cup muffin tin and bake for 15 to 20 minutes, rotating halfway."
      ]
    }
  ],
