  "steps": [
    {
      "do": "Chop the onion, peel and chop the carrots, and press or mince the garlic.",
      "hands": "6 min",
      "prep": true,
      "prepOnly": true,
      "uses": [
        "Yellow or white onion",
        "Carrots",
        "Garlic"
      ]
    },
    {
      "do": "Heat the oil over medium in a Dutch oven or heavy stainless pot of 5 quarts or more until it shimmers. Add the onion and carrot and cook, stirring often, about 5 minutes, until the onion is soft and translucent.",
      "wait": "About 5 min",
      "uses": [
        "Extra virgin olive oil",
        "Yellow or white onion",
        "Carrots"
      ],
      "hands": "1 min",
      "watch": true,
      "burner": true
    },
    {
      "do": "Add the garlic, cumin, curry powder and thyme and stir constantly about 30 seconds, just until fragrant; stainless scorches spices fast, so keep stirring. Add the tomatoes and cook a few minutes more, stirring often.",
      "uses": [
        "Garlic",
        "Ground cumin",
        "Curry powder",
        "Dried thyme",
        "Diced tomatoes"
      ],
      "hands": "3 min",
      "burner": true
    },
    {
      "do": "Pick over and rinse the lentils. Strip the tough ribs from the greens and chop the leaves. Juice the lemon.",
      "hands": "5 min",
      "prep": true,
      "prepOnly": true,
      "uses": [
        "Brown or green lentils",
        "Collard greens or kale",
        "Lemon juice (1/2 to 1 medium lemon)"
      ]
    },
    {
      "do": "Add the lentils, broth, water, 1 tsp salt, the pepper flakes and plenty of black pepper. Bring to a boil, partially cover, and simmer gently 25 to 30 minutes, until the lentils are tender but still hold their shape.",
      "wait": "25 to 30 min",
      "uses": [
        "Brown or green lentils",
        "Vegetable broth",
        "Water",
        {
          "item": "Salt",
          "amount": "1 tsp"
        },
        "Red pepper flakes",
        {
          "item": "Black pepper",
          "amount": "plenty"
        }
      ],
      "hands": "2 min",
      "burner": true
    },
    {
      "do": "Blend 2 cups of the soup until smooth and stir it back in; this is what makes it creamy without cream. Lock the blender lid and hold a towel over it against the steam. An immersion blender used briefly in the pot works too.",
      "hands": "4 min",
      "burner": true
    },
    {
      "do": "Add the greens and simmer 5 minutes more, until as tender as you like.",
      "wait": "5 min",
      "uses": [
        "Collard greens or kale"
      ],
      "hands": "1 min",
      "burner": true
    },
    {
      "do": "Off the heat, stir in 1 tbsp lemon juice. Taste and adjust with more salt, pepper or lemon. Serve hot.",
      "uses": [
        "Lemon juice (1/2 to 1 medium lemon)",
